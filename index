<style>
:root{--pink:#f9014d;--purple:#6a2cf0;--blue:#2f6bff;--deep:#1d0f66;--ok:#46e39a;--bad:#ff6b4a;--lav:#a99bff;
--display:'Fredoka',system-ui,-apple-system,'Segoe UI',sans-serif;--body:'Fira Sans',system-ui,-apple-system,'Segoe UI',sans-serif}
*{box-sizing:border-box}
html{background:#1b3aa8}
body{margin:0;min-height:100vh;background:linear-gradient(160deg,#5a22e0 0%,#3a1bb4 45%,#1f3fb8 100%);background-attachment:fixed;color:#fff;font-family:var(--body);font-weight:400;overflow-x:hidden}
button{font:inherit;cursor:pointer}
button:focus-visible,a:focus-visible{outline:3px solid #fff;outline-offset:3px}
.app{width:min(100%,520px);min-height:100svh;margin:auto;padding:18px 20px 26px;display:flex;flex-direction:column}
.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;gap:10px}
.brand{display:flex;align-items:center;gap:10px}
.plate{background:#fff;border-radius:12px;padding:6px 9px;display:flex;box-shadow:0 3px 0 rgba(0,0,0,.25)}
.plate img{height:30px;width:auto;display:block}
.wm{font-family:var(--display);font-weight:700;font-size:21px;line-height:1}
.sticker{font-family:var(--display);background:var(--pink);color:#fff;border-radius:8px;padding:7px 11px;font-size:14px;font-weight:700;transform:rotate(3deg);box-shadow:0 3px 0 rgba(0,0,0,.25)}
.screen{display:none;flex:1;flex-direction:column}
.screen.active{display:flex}
.eyebrow{font-family:var(--display);color:#ffd1e3;font-size:17px;font-weight:600}
h1{font-family:var(--display);font-size:clamp(40px,12vw,60px);line-height:1.02;margin:8px 0 14px;font-weight:700;letter-spacing:-1px}
h1 .accent{background:linear-gradient(transparent 58%,var(--pink) 58%);padding:0 5px;margin:0 -5px}
.subtitle{color:#e7e0ff;line-height:1.5;font-size:19px;max-width:360px;margin:0}
.hint{text-align:center;color:#d8cffc;font-size:15px;font-style:italic;margin:18px 0 0}
.hero-art{flex:1;min-height:170px;margin:14px 0 22px;position:relative}
.word-card{--sh:rgba(0,0,0,.28);position:absolute;border-radius:20px;padding:15px 24px;font-family:var(--display);font-size:28px;font-weight:700;box-shadow:0 7px 0 var(--sh);text-transform:lowercase;transform:rotate(var(--r));animation:float 3.4s ease-in-out infinite}
.w1{--r:-7deg;background:#fff;color:var(--deep);left:1%;top:6%}
.w2{--r:6deg;background:linear-gradient(135deg,#2f6bff,#6a8dff);color:#fff;right:1%;top:30%;animation-delay:-1.1s}
.w3{--r:3deg;background:linear-gradient(135deg,var(--pink),#ff4b85);color:#fff;left:24%;bottom:8%;animation-delay:-2.2s}
@keyframes float{50%{transform:rotate(var(--r)) translateY(-10px)}}
.btn{--sh:var(--lav);display:block;width:100%;border:0;border-radius:18px;padding:17px 20px;font-family:var(--display);font-size:22px;font-weight:700;text-align:center;text-decoration:none;color:var(--deep);background:#fff;box-shadow:0 6px 0 var(--sh);transition:transform .1s,box-shadow .1s}
.btn:active{transform:translateY(5px);box-shadow:0 1px 0 var(--sh)}
.btn-main{--sh:#a3002f;background:linear-gradient(180deg,#ff3d78,var(--pink));color:#fff}
.btn-go{--sh:#12873f;background:#25d366;color:#06331a}
.result-center .btn{margin-top:18px}
.result-center .btn-go{margin-top:22px}
.screen.active>*{animation:rise .5s cubic-bezier(.2,.8,.3,1) backwards}
.screen.active>*:nth-child(2){animation-delay:.05s}.screen.active>*:nth-child(3){animation-delay:.1s}.screen.active>*:nth-child(4){animation-delay:.15s}.screen.active>*:nth-child(5){animation-delay:.2s}.screen.active>*:nth-child(6){animation-delay:.25s}.screen.active>*:nth-child(n+7){animation-delay:.3s}
@keyframes rise{from{opacity:0;transform:translateY(18px)}}
.screen.active>.btn-main,.screen.active>.btn-go{animation:rise .5s cubic-bezier(.2,.8,.3,1) .3s backwards,hop 2.6s ease-in-out 1.2s infinite}
.screen.active>.btn:active{animation:none}
@keyframes hop{0%,88%,100%{transform:none}92%{transform:translateY(-5px)}96%{transform:none}}
.game-head{display:flex;justify-content:space-between;align-items:flex-end}
.stat-label{font-size:15px;color:#d8cffc;font-weight:600}
.stat-value{font-family:var(--display);font-size:36px;font-weight:700;line-height:1.1}
.timer-wrap{height:14px;background:rgba(255,255,255,.2);border-radius:20px;overflow:hidden;margin:12px 0 18px}
.timer-bar{height:100%;width:100%;background:#5cc8ff;border-radius:20px;transition:width .1s linear,background .3s}
.timer-bar.warn{background:#ffc933}
.timer-bar.danger{background:var(--bad);animation:blink .4s ease-in-out infinite alternate}
.stat-value.danger{color:#ffb199;animation:blink .4s ease-in-out infinite alternate}
@keyframes blink{to{opacity:.5}}
#score{transform-origin:left}
.bump{animation:bump .3s ease-out}
@keyframes bump{40%{transform:scale(1.3);color:#ffd1e3}}
.mission{background:linear-gradient(135deg,var(--pink),#b11cff);border-radius:22px;padding:18px 20px;margin-bottom:18px;box-shadow:0 6px 0 rgba(0,0,0,.28)}
.mission small{font-family:var(--display);font-size:15px;font-weight:600;color:#ffe3ee}
.mission h2{font-family:var(--display);font-size:28px;line-height:1.1;margin:6px 0 4px;font-weight:700}
.mission p{font-size:17px;margin:0;opacity:.95}
.screen.active>.mission.swap{animation:swap .4s cubic-bezier(.2,.8,.3,1)}
@keyframes swap{from{opacity:.2;transform:translateX(-18px)}}
.arena{flex:1;min-height:250px;max-height:430px;position:relative;overflow:hidden;padding:4px 2px 10px;display:flex}
.screen.active>.arena.err{animation:shake .3s}
.words{flex:1;display:grid;grid-template-columns:repeat(2,1fr);grid-auto-rows:minmax(60px,1fr);gap:13px}
.word:last-child:nth-child(odd){grid-column:1/-1}
.word{--sh:var(--lav);border:0;color:var(--deep);background:#fff;border-radius:18px;padding:14px 8px;font-family:var(--display);font-size:22px;font-weight:700;text-transform:lowercase;min-height:60px;touch-action:manipulation;box-shadow:0 5px 0 var(--sh);animation:pop .22s ease-out backwards;transition:transform .1s,box-shadow .1s}
.word:active{transform:translateY(4px);box-shadow:0 1px 0 var(--sh)}
.word.correct{--sh:#1f9e63;background:var(--ok);color:#06361d;animation:win .35s ease-out}
.word.wrong{--sh:#b8391f;background:var(--bad);color:#fff;animation:shake .35s}
.word.correct,.word.wrong{animation-delay:0s!important}
@keyframes pop{from{opacity:0;transform:scale(.8) translateY(8px)}}
@keyframes win{40%{transform:scale(1.15)}}
@keyframes shake{20%,60%{transform:translateX(-7px)}40%,80%{transform:translateX(7px)}}
.float{position:absolute;z-index:5;pointer-events:none;font-family:var(--display);font-weight:700;font-size:23px;transform:translate(-50%,0);animation:floatup .8s ease-out forwards}
@keyframes floatup{to{transform:translate(-50%,-52px);opacity:0}}
.feedback{height:30px;text-align:center;margin:10px 0 0;font-family:var(--display);font-size:20px;font-weight:700;color:var(--ok)}
.bottom-stats{display:flex;justify-content:space-between;color:#d8cffc;font-size:16px;font-weight:600;padding:8px 2px 0}
.bottom-stats b{color:#fff}
.combo-hot{display:inline-block;color:#ffc933;animation:flame .45s ease-in-out infinite alternate}
@keyframes flame{to{transform:scale(1.35) rotate(-6deg)}}
.result-center{text-align:center;align-items:center}
.result-num{font-family:var(--display);font-size:108px;line-height:1;font-weight:700;color:#fff;margin:8px 0 2px;text-shadow:5px 5px 0 var(--pink)}
.screen.active>.result-num{animation:slam .6s cubic-bezier(.2,1.5,.4,1) .1s backwards}
@keyframes slam{from{opacity:0;transform:scale(2.4)}}
.claim{font-family:var(--display);font-size:28px;font-weight:700;line-height:1.15;margin:14px 0 6px}
.cta-note{font-size:15px;color:#d8cffc;font-style:italic;margin:16px 0 0}
.result-card{width:100%;background:#fff;color:var(--deep);border-radius:20px;padding:10px 18px;margin:24px 0 4px;text-align:left;box-shadow:0 5px 0 var(--lav)}
.result-row{display:flex;justify-content:space-between;padding:6px 0;font-size:17px}
.result-row span{color:#6b5fb0}
@media(max-height:740px){.app{padding-top:14px}.top{margin-bottom:12px}.hero-art{min-height:130px;margin:8px 0 16px}.arena{min-height:220px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<main class="app">
  <header class="top">
    <div class="brand"><span class="plate"><img src="data:image/png;base64," alt="KNN Idiomas"></span><span class="wm">Word Snap</span></div>
    <div class="sticker">Black November</div>
  </header>

  <section class="screen active" id="home">
    <div class="eyebrow">Desafio KNN</div>
    <h1>Quantas palavras<br>você <span class="accent">já sabe?</span></h1>
    <p class="subtitle">40 segundos. Zero pressão. Só precisa de reflexo.</p>
    <div class="hero-art" aria-hidden="true">
      <div class="word-card w1">shoes</div>
      <div class="word-card w2">apple</div>
      <div class="word-card w3">jacket</div>
    </div>
    <button class="btn btn-main" id="start">Jogar agora</button>
    <p class="hint">Sem cadastro. Leva menos de 1 minuto.</p>
  </section>

  <section class="screen" id="game">
    <div class="game-head">
      <div><div class="stat-label">Pontos</div><div class="stat-value" id="score">0000</div></div>
      <div style="text-align:right"><div class="stat-label">Tempo</div><div class="stat-value" id="time">40s</div></div>
    </div>
    <div class="timer-wrap"><div class="timer-bar" id="timerBar"></div></div>
    <div class="mission">
      <small>Sua missão</small>
      <h2 id="missionTitle"></h2>
      <p id="missionSub"></p>
    </div>
    <div class="arena"><div class="words" id="words"></div></div>
    <div class="feedback" id="feedback" aria-live="polite">Valendo!</div>
    <div class="bottom-stats">
      <span>Combo: <b id="combo">0</b></span>
      <span>Acertos: <b id="hits">0</b></span>
    </div>
  </section>

  <section class="screen result-center" id="result">
    <div class="eyebrow">Fim de jogo</div>
    <h1 id="resultTitle"></h1>
    <div class="result-num" id="finalHits">0</div>
    <div class="stat-label">palavras reconhecidas</div>
    <p class="claim" id="claim"></p>
    <p class="subtitle" style="text-align:center">Em novembro, atravessar custa menos.</p>
    <a class="btn btn-go" id="cta" target="_blank" rel="noopener noreferrer">Quero começar com desconto</a>
    <p class="cta-note">Você entra na comunidade da campanha no WhatsApp.</p>
    <div class="result-card">
      <div class="result-row"><span>Pontos</span><b id="finalScore">0</b></div>
      <div class="result-row"><span>Melhor combo</span><b id="finalCombo">0x</b></div>
      <div class="result-row"><span>Precisão</span><b id="accuracy">0%</b></div>
    </div>
    <button class="btn" id="again">Jogar de novo</button>
    <button class="btn" id="share">Desafiar um amigo</button>
  </section>
</main>

<script>
/* ===== CONFIGURAÇÃO (edite aqui) ===== */
const CONFIG = {
  COMMUNITY_URL: 'https://chat.whatsapp.com/GuKPx1CFCss1q83uje9i2u?s=sw&p=i&mlu=4&ilr=4&iam=2',
  SHARE_URL: '',  // link público do jogo usado na mensagem de desafio (vazio = usa o endereço da própria página)
  DURATION: 40,   // segundos de jogo
  PENALTY: 2      // segundos perdidos a cada erro
};

/* Eventos de métrica: se a página tiver Google Analytics (gtag) ou Meta Pixel (fbq), eles são enviados sozinhos. */
function track(name, params) {
  try {
    if (window.gtag) gtag('event', name, params || {});
    if (window.fbq) fbq('trackCustom', name, params || {});
  } catch (e) {}
}

/* Cada missão: 5 palavras certas (sorteia 3) + 4 distratores. Nenhuma palavra certa aparece como distrator. */
const missions = [
  {title:"ENCONTRE ALGO QUE VOCÊ VESTE", sub:"Roupas e acessórios.", targets:["SHOES","JACKET","HAT","DRESS","SHIRT"], distractors:["APPLE","TABLE","WATER","CLOUD"]},
  {title:"ENCONTRE ALGO DE COMER", sub:"O que vai para o seu prato?", targets:["APPLE","BREAD","PIZZA","CHEESE","BANANA"], distractors:["WINDOW","SHOES","PHONE","RIVER"]},
  {title:"ENCONTRE ALGO DA CASA", sub:"O que você encontra em casa?", targets:["CHAIR","TABLE","WINDOW","DOOR","SOFA"], distractors:["TIGER","APPLE","BEACH","SHIRT"]},
  {title:"ENCONTRE UM ANIMAL", sub:"Quem faz parte do reino animal?", targets:["TIGER","DOG","BIRD","HORSE","CAT"], distractors:["PENCIL","WATER","CHAIR","MUSIC"]},
  {title:"ENCONTRE ALGO DA NATUREZA", sub:"O que faz parte do mundo natural?", targets:["RIVER","TREE","FLOWER","SUN","MOUNTAIN"], distractors:["JACKET","PHONE","BREAD","SCHOOL"]},
  {title:"ENCONTRE ALGO DA ESCOLA", sub:"O que você usa para aprender?", targets:["PENCIL","BOOK","PEN","RULER","BACKPACK"], distractors:["BANANA","CLOUD","SHOES","HORSE"]},
  {title:"ENCONTRE UMA COR", sub:"Quais são cores?", targets:["RED","BLUE","GREEN","YELLOW","PINK"], distractors:["DOG","TABLE","BREAD","SCHOOL"]},
  {title:"ENCONTRE UM NÚMERO", sub:"Contando em inglês.", targets:["ONE","TWO","THREE","FOUR","FIVE"], distractors:["APPLE","TREE","HAT","WATER"]},
  {title:"ENCONTRE ALGUÉM DA FAMÍLIA", sub:"Quem mora no coração da família?", targets:["MOTHER","FATHER","SISTER","BROTHER","GRANDMA"], distractors:["HORSE","PHONE","PIZZA","CLOUD"]}
];

let score, hits, misses, combo, bestCombo, endAt, activeTargets;
let usedMissions = [], tick = null, missionTimeout = null, playing = false, locked = false;
const $ = id => document.getElementById(id);

/* ===== Efeitos (leves, sem bibliotecas) ===== */
const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
function vib(n){ try { navigator.vibrate && navigator.vibrate(n); } catch (e) {} }
function bump(el){ el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump'); }
function burst(el, colors, n){
  if (reduce) return;
  const r = el.getBoundingClientRect(), x = r.left + r.width / 2, y = r.top + r.height / 2;
  for (let i = 0; i < n; i++) {
    const d = document.createElement('i'), a = Math.random() * 6.283, dist = 40 + Math.random() * 50;
    d.style.cssText = 'position:fixed;z-index:50;pointer-events:none;width:8px;height:8px;border-radius:50%;left:' + x + 'px;top:' + y + 'px;background:' + colors[i % colors.length];
    document.body.appendChild(d);
    d.animate([
      {transform:'translate(-50%,-50%) scale(1)', opacity:1},
      {transform:'translate(calc(-50% + ' + Math.cos(a) * dist + 'px),calc(-50% + ' + Math.sin(a) * dist + 'px)) scale(.2)', opacity:0}
    ], {duration: 550 + Math.random() * 200, easing:'ease-out'}).onfinish = () => d.remove();
  }
}
function floatText(el, text, color){
  const arena = el.closest('.arena'), a = arena.getBoundingClientRect(), r = el.getBoundingClientRect();
  const s = document.createElement('span');
  s.className = 'float'; s.textContent = text; s.style.color = color;
  s.style.left = (r.left - a.left + r.width / 2) + 'px';
  s.style.top = (r.top - a.top) + 'px';
  arena.appendChild(s);
  setTimeout(() => s.remove(), 800);
}
function confetti(n){
  if (reduce) return;
  const cols = ['#f9014d','#ffffff','#5cc8ff','#9b6bff','#ffc933'];
  for (let i = 0; i < n; i++) {
    const p = document.createElement('i'), w = 6 + Math.random() * 6;
    p.style.cssText = 'position:fixed;z-index:50;pointer-events:none;top:-12px;left:' + Math.random() * innerWidth + 'px;width:' + w + 'px;height:' + w * 1.6 + 'px;border-radius:2px;background:' + cols[i % 5];
    document.body.appendChild(p);
    p.animate([
      {transform:'translateY(0) rotate(0deg)', opacity:1},
      {transform:'translate(' + (Math.random() * 120 - 60) + 'px,' + (innerHeight + 30) + 'px) rotate(' + Math.random() * 720 + 'deg)', opacity:.9}
    ], {duration: 1400 + Math.random() * 1200, delay: Math.random() * 300, easing:'cubic-bezier(.3,.4,.6,1)', fill:'backwards'}).onfinish = () => p.remove();
  }
}
function countUp(el, to){
  if (reduce || to === 0) { el.textContent = to; return; }
  const t0 = performance.now(), ms = 700 + to * 15;
  (function f(t){
    const k = Math.min(1, (t - t0) / ms);
    el.textContent = Math.round(to * (1 - Math.pow(1 - k, 3)));
    if (k < 1) requestAnimationFrame(f);
  })(t0);
}

function showScreen(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  $(id).classList.add('active');
  window.scrollTo(0, 0);
}
function shuffle(arr){
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
const timeLeft = () => Math.max(0, (endAt - performance.now()) / 1000);

function nextMission(){
  if (usedMissions.length === missions.length) usedMissions = [];
  const available = missions.map((m, i) => i).filter(i => !usedMissions.includes(i));
  const index = available[Math.floor(Math.random() * available.length)];
  usedMissions.push(index);
  const m = missions[index];
  activeTargets = shuffle(m.targets).slice(0, 3);
  $('missionTitle').textContent = m.title.charAt(0) + m.title.slice(1).toLowerCase();
  $('missionSub').textContent = m.sub + ' Toque nas 3 certas!';
  const mc = document.querySelector('.mission'); mc.classList.remove('swap'); void mc.offsetWidth; mc.classList.add('swap');
  const box = $('words');
  box.innerHTML = '';
  shuffle([...activeTargets, ...m.distractors]).forEach((word, i) => {
    const b = document.createElement('button');
    b.className = 'word'; b.style.animationDelay = (i * 45) + 'ms';
    b.textContent = word;
    b.setAttribute('aria-label', 'Palavra ' + word);
    b.addEventListener('click', () => chooseWord(b, word));
    box.appendChild(b);
  });
}

function chooseWord(button, word){
  if (!playing || locked || button.disabled) return;
  button.disabled = true;
  if (activeTargets.includes(word)) {
    button.classList.add('correct');
    button.textContent = '✓ ' + word;
    activeTargets = activeTargets.filter(x => x !== word);
    combo++; hits++;
    bestCombo = Math.max(bestCombo, combo);
    const pts = 100 + Math.min(combo - 1, 4) * 25;  // bônus de combo limitado a +100
    score += pts;
    burst(button, ['#46e39a','#ffffff','#f9014d'], 10); floatText(button, '+' + pts, '#7dffb3'); vib(15); bump($('score'));
    setFeedback(combo >= 3 ? 'Combo x' + combo + '! +' + pts : 'Boa! +' + pts, 'var(--ok)');
    if (activeTargets.length === 0) {
      locked = true;
      setFeedback('Missão completa!', 'var(--ok)');
      missionTimeout = setTimeout(() => { locked = false; if (playing) nextMission(); }, 450);
    }
  } else {
    button.classList.add('wrong');
    button.textContent = '✕ ' + word;
    misses++; combo = 0;
    endAt -= CONFIG.PENALTY * 1000;
    setFeedback('Ops! -' + CONFIG.PENALTY + ' segundos', 'var(--bad)');
    floatText(button, '-' + CONFIG.PENALTY + 's', '#ffb199'); vib(60);
    const ar = document.querySelector('.arena'); ar.classList.remove('err'); void ar.offsetWidth; ar.classList.add('err');
  }
  updateStats();
  if (timeLeft() <= 0) endGame();
}
function setFeedback(text, color){ $('feedback').textContent = text; $('feedback').style.color = color; }

function updateStats(){
  const t = timeLeft();
  $('score').textContent = String(score).padStart(4, '0');
  $('combo').textContent = combo;
  $('hits').textContent = hits;
  $('time').textContent = Math.ceil(t) + 's';
  $('timerBar').style.width = (t / CONFIG.DURATION * 100) + '%';
  $('timerBar').className = 'timer-bar' + (t <= 7 ? ' danger' : t <= 15 ? ' warn' : '');
  $('time').classList.toggle('danger', t <= 7 && playing);
  $('combo').classList.toggle('combo-hot', combo >= 3 && playing);
}

function startGame(){
  clearInterval(tick); clearTimeout(missionTimeout);
  score = hits = misses = combo = bestCombo = 0;
  usedMissions = []; locked = false; playing = true;
  endAt = performance.now() + CONFIG.DURATION * 1000;
  setFeedback('Valendo!', 'var(--ok)');
  updateStats(); showScreen('game'); nextMission();
  tick = setInterval(() => { updateStats(); if (timeLeft() <= 0) endGame(); }, 100);
  track('knn_game_start');
}

function endGame(){
  if (!playing) return;
  playing = false; clearInterval(tick); clearTimeout(missionTimeout);
  updateStats();
  countUp($('finalHits'), hits);
  $('finalScore').textContent = score;
  $('finalCombo').textContent = bestCombo + 'x';
  $('accuracy').textContent = (hits + misses ? Math.round(hits / (hits + misses) * 100) : 0) + '%';
  $('resultTitle').innerHTML = hits >= 18 ? 'Você<br><span class="accent">é brabo!</span>'
                           : hits >= 9  ? 'Mandou<br><span class="accent">bem!</span>'
                           :              'Boa<br><span class="accent">largada!</span>';
  $('claim').textContent = hits === 0 ? 'Toda porta começa com a primeira tentativa.'
                         : 'Primeira porta aberta.';
  showScreen('result');
  if (hits > 0) confetti(Math.min(70, 24 + hits * 3));
  track('knn_game_end', {words: hits, score: score});
}

function shareChallenge(){
  const url = CONFIG.SHARE_URL || (location.origin + location.pathname);
  const text = hits > 0
    ? 'Quantas palavras em inglês você já sabe? Eu reconheci ' + hits + ' em 40 segundos no Desafio KNN. Bora tentar me superar? ' + url
    : 'Quantas palavras em inglês você já sabe? Faça o Desafio KNN: são só 40 segundos. ' + url;
  track('knn_share_click', {words: hits});
  window.open('https://wa.me/?text=' + encodeURIComponent(text), '_blank', 'noopener');
}

$('cta').href = CONFIG.COMMUNITY_URL;
$('cta').addEventListener('click', () => track('knn_cta_click', {words: hits, score: score}));
$('start').addEventListener('click', startGame);
$('again').addEventListener('click', startGame);
$('share').addEventListener('click', shareChallenge);
</script>
</body>
</html>
